<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
    Which mod manager profile to build against and deploy into.
    Thunderstore Mod Manager (the current official app) stores profiles under
    "Thunderstore Mod Manager\DataFolder\<Game>\profiles\<Game> - <Profile>". If you're on the
    older r2modman app instead, override BepInEx directly, e.g.:
      dotnet build -p:BepInEx="%AppData%\r2modmanPlus-local\GTFO\profiles\Default\BepInEx"
    -->
    <GameName>GTFO</GameName>
    <Profile>Easy Mode DEV</Profile>

    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <AssemblyName>GTFO.EZ</AssemblyName>
    <RootNamespace>GTFO.EZ</RootNamespace>

    <BepInEx>$(AppData)\Thunderstore Mod Manager\DataFolder\$(GameName)\profiles\$(GameName) - $(Profile)\BepInEx</BepInEx>
    <OutputPath>$(BepInEx)\plugins\GTFO.EZ\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="PostBuild" BeforeTargets="PostBuildEvent">
    <Delete Files="$(OutputPath)$(AssemblyName).deps.json" />
  </Target>

  <!-- BepInEx + HarmonyX + Il2CppInterop core -->
  <ItemGroup>
    <Reference Include="$(BepInEx)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- Unhollowed/interop game assemblies (GameData, UnityEngine, etc.) -->
  <ItemGroup>
    <Reference Include="$(BepInEx)\interop\*.dll" Private="false" />
    <Reference Remove="$(BepInEx)\interop\netstandard.dll" />
  </ItemGroup>

  <!-- Shared/KitLoot.cs is published to GTFO.AbsurdItems only (tools/publish-shared.ps1)
       but isn't used here since Consumables Are Kits moved to GTFO.AbsurdItems, so it's left out of this
       build rather than shipping its unused Harmony patch. GTFO.AbsurdItems' copy compiles it. -->
  <ItemGroup>
    <Compile Remove="Shared\KitLoot.cs" />
    <None Include="Shared\KitLoot.cs" />
  </ItemGroup>

  <!-- Pure balance data/math, shared with tests/GTFO.EZ.Core.Tests - see the root README's Project layout section. -->
  <ItemGroup>
    <ProjectReference Include="..\GTFO.EZ.Core\GTFO.EZ.Core.csproj" />
  </ItemGroup>

</Project>
